# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
CTF_ENV=development
CTF_SECRET_KEY=replace-with-a-long-random-secret
# Use 1 only when the platform is served through HTTPS.
# Set to 1 in production (HTTPS is required when CTF_ENV=production).
CTF_COOKIE_SECURE=0

# Docker challenge environments
CTF_INSTANCE_TTL_MINUTES=30
CTF_MAX_ACTIVE_INSTANCES_PER_USER=2
CTF_INSTANCE_CLEANUP_INTERVAL=30
# Local development defaults. For remote hosting, configure the public host
# and bind address deliberately, and restrict published ports with a firewall.
CTF_DOCKER_BIND_HOST=127.0.0.1
CTF_PUBLIC_HOST=127.0.0.1
# Keep 127.0.0.1 or ::1 unless you deliberately need remote access.
CTF_ALLOW_REMOTE_DOCKER_BIND=0

# Flag submission protection: maximum attempts per user in a rolling 60-second window
CTF_FLAG_ATTEMPTS_PER_MINUTE=10

# In-process login/register protection (per direct client IP).
CTF_AUTH_ATTEMPTS=10
CTF_AUTH_WINDOW_SECONDS=900
